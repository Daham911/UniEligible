# UniEligible Environment Configuration Template

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unieligible
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api/v1

# AWS Deployment Configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=unieligible-backend
AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/github-actions-devsecops-role

# SonarCloud Configuration
SONAR_TOKEN=your_sonar_token_here
SONAR_ORGANIZATION=your_sonarcloud_org
SONAR_PROJECT_KEY=unieligible-backend

